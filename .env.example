# Copy to .env for local development, or add these in Vercel → Project → Settings → Environment Variables.

# Required in production: a long random string (python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=

# Postgres connection string (Neon / Vercel Postgres / Supabase). Without it, Vercel runs a
# temporary demo database that resets on every cold start.
DATABASE_URL=

# Staff/admin account created automatically on deploy (if it doesn't exist yet)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_EMAIL=

# Optional: custom domain(s)
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,holycross.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://holycross.example

# Optional: email notifications for the contact form (Gmail requires an app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=

# Optional: video consultations (https://console.zegocloud.com)
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# Optional: hospital details shown on the site
# HOSPITAL_NAME=HolyCross Hospital
# HOSPITAL_PHONE=+91 85905 69016
# HOSPITAL_EMERGENCY=+91 85905 69016
# HOSPITAL_EMAIL=care@holycross.example
# HOSPITAL_ADDRESS=HolyCross Hospital, Kochi, Kerala, India
